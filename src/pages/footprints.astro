---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/Layout.astro";
---

<PageLayout title="Footprints" description="A map of the cities and countries I've explored.">
  <Container>
    <h1 class="animate font-semibold text-black dark:text-white mb-6">
      Footprints
    </h1>

    <p class="animate text-black/75 dark:text-white/75">
      Coding locally, deploying globally. A map of the cities and countries I've explored.
    </p>

    <!-- Year filter -->
    <div id="year-filter" class="animate mt-8 flex flex-wrap gap-2">
      <button
        class="year-btn active px-3 py-1 text-xs rounded-full border border-black/15 dark:border-white/20 bg-black text-white dark:bg-white dark:text-black transition-colors"
        data-year="all"
      >All</button>
    </div>

    <!-- A/B view toggle -->
    <div class="animate mt-4 flex gap-2">
      <button
        id="btn-3d"
        class="view-toggle active px-4 py-1.5 text-xs font-medium rounded-md border border-black/15 dark:border-white/20 bg-black text-white dark:bg-white dark:text-black transition-colors"
      >3D Globe</button>
      <button
        id="btn-2d"
        class="view-toggle px-4 py-1.5 text-xs font-medium rounded-md border border-black/15 dark:border-white/20 bg-transparent text-black/75 dark:text-white/75 transition-colors"
      >2D Map</button>
    </div>

    <!-- 3D Globe view (cobe WebGL) -->
    <div
      id="view-3d"
      class="animate mt-6 w-full aspect-video border border-black/10 dark:border-white/10 rounded-lg overflow-hidden bg-neutral-950 relative translate-y-[20%] cursor-grab active:cursor-grabbing"
    >
      <canvas id="globe-canvas" style="width:100%;height:100%"></canvas>
    </div>

    <!-- 2D Map view (D3 + TopoJSON SVG) -->
    <div
      id="view-2d"
      class="animate mt-6 w-full aspect-video border border-black/10 dark:border-white/10 rounded-lg overflow-hidden bg-neutral-100 dark:bg-neutral-800 relative hidden"
    >
      <svg id="map-svg" style="width:100%;height:100%"></svg>
    </div>

    <!-- Terminal Log -->
    <div class="animate mt-12">
      <div class="rounded-lg border border-black/10 dark:border-white/10 overflow-hidden font-mono text-xs">
        <div class="flex items-center gap-2 px-4 py-2 bg-neutral-200 dark:bg-neutral-800 border-b border-black/10 dark:border-white/10">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-red-400"></span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-green-400"></span>
          <span class="ml-2 text-black/50 dark:text-white/50 select-none">terminal — footprints.log</span>
        </div>
        <div id="terminal-body" class="p-4 bg-neutral-950 text-green-400 max-h-80 overflow-y-auto leading-relaxed space-y-0.5">
          <p class="text-white/30">$ cat footprints.log</p>
        </div>
      </div>
    </div>
  </Container>
</PageLayout>

<script>
