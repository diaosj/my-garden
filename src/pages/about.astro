---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/Layout.astro";
import Link from "@components/Link.astro";
import SectionLabel from "@components/SectionLabel.astro";
import { ABOUT, SITE, SOCIALS } from "@consts";
import { graph, PERSON_JSONLD, WEBSITE_JSONLD } from "@lib/seo";

const jsonld = graph(
  { ...PERSON_JSONLD, mainEntityOfPage: "https://diaosj.info/about/" },
  WEBSITE_JSONLD,
  {
    "@type": "ProfilePage",
    "@id": "https://diaosj.info/about/",
    mainEntity: { "@id": "https://diaosj.info/#person" },
  },
);
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION} jsonld={jsonld}>
  <Container>
    <h1 class="animate mb-2 font-mono text-xl font-medium text-ink">About</h1>
    <p class="animate t-muted mb-10 text-sm" lang="zh-CN">
      刁寿钧，AI 基础设施架构师，现任 Lovart 架构师，前腾讯云 AI 平台架构师；业余围棋五段，技术图书译者。
    </p>

    <div class="space-y-16">
      <!-- Copy draft by Claude 2026-10-25; Adrian to edit before merge. -->
      <section class="animate max-w-prose space-y-4 leading-relaxed text-ink">
        <p>
          In March 2016 I watched AlphaGo play Lee Sedol the way an amateur 5-dan watches anything: counting, and
          expecting to be able to follow. By game two I couldn't. Move 37 wasn't a move I would have rejected — it was
          one I would never have considered. I had been a backend engineer for eight years. That week I decided the
          thing that beat me was the thing I wanted to build.
        </p>
        <p>
          I taught myself deep reinforcement learning, gave a seminar on it to my team, and spent the next seven years
          at Tencent turning that interest into infrastructure: the unified AI platform of Tencent Cloud, built from
          nothing, and the gateways that carried it through the first wave of LLM traffic. Today I do the same job at
          Lovart for generative media: routing, serving and paying for models so a global product stays up.
        </p>
        <p>
          I like systems that are honest about their limits, people who explain things plainly, and games where the
          position tells you what to do next.
        </p>
      </section>

      <section class="animate space-y-2">
        <SectionLabel index="01" label="Path" />
        {
          [
            { role: "Architect", org: "Lovart", years: "2025 — now", note: "Inference serving, model gateways, multi-cloud GPU and cost for image, video and LLM generation." },
            { role: "Staff Engineer, AI Platform Architect", org: "Tencent", years: "2018 — 2025", note: "Tencent Cloud's unified AI platform from zero; cloud-native gateways that absorbed a 100× traffic rise during the LLM boom." },
            { role: "Senior Backend Engineer", org: "Tencent", years: "2016 — 2018", note: "Microservices refactor of the brand-advertising system." },
            { role: "Senior Engineer", org: "Bilibili", years: "2016", note: "Core backend for creators during the move to microservices." },
            { role: "Backend Developer", org: "Adways (Nint)", years: "2012 — 2015", note: "Early engineer on an e-commerce analytics product, built from scratch." },
          ].map((e) => (
            <div class="grid items-baseline gap-x-8 gap-y-1 border-b border-rule py-5 sm:grid-cols-[1fr_auto]">
              <div>
                <div class="text-ink">
                  <span class="font-medium">{e.role}</span>, {e.org}
                </div>
                <div class="t-muted mt-1 text-sm">{e.note}</div>
              </div>
              <div class="t-muted font-mono text-xs whitespace-nowrap sm:text-right">{e.years}</div>
            </div>
          ))
        }
      </section>

      <section class="animate space-y-2">
        <SectionLabel index="02" label="Beyond" />
        <p class="t-muted max-w-prose py-4">
          I have spoken at the Apache APISIX Meetup on high-performance gateways, translated two technical books into
          Chinese, run a 200-person football association at Tencent, and taught Go to children of migrant workers in
          Shanghai. I am learning Japanese and Spanish, slowly and out loud.
        </p>
      </section>

      <section class="animate space-y-2">
        <SectionLabel index="03" label="Connect" />
        <div class="flex flex-wrap gap-x-6 gap-y-2 py-4 font-mono text-sm">
          <Link href="https://github.com/diaosj" external>github</Link>
          <Link href="https://www.linkedin.com/in/shoujun-diao/" external>linkedin</Link>
          <Link href="https://x.com/diaosj" external>x</Link>
          <Link href={`mailto:${SITE.EMAIL}`}>email</Link>
        </div>
      </section>
    </div>
  </Container>
</PageLayout>
