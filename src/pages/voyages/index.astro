---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/Layout.astro";
import { VOYAGES } from "@consts";
import kyushu from "@data/kyushu-2026.json";
import sendai from "@data/sendai-2026.json";

const trips = [
  { slug: "sendai-2026", data: sendai, emoji: "\u{1F386}" },
  { slug: "kyushu-2026", data: kyushu, emoji: "\u{1F338}" },
];
---

<PageLayout title={VOYAGES.TITLE} description={VOYAGES.DESCRIPTION}>
  <Container>
    <h1 class="animate font-semibold text-ink">
      {VOYAGES.TITLE}
    </h1>
    <p class="animate mt-2 text-ink/80">
      {VOYAGES.DESCRIPTION}
    </p>

    <div class="animate mt-8 space-y-3">
      {
        trips.map((trip) => (
          <a
            href={`/voyages/${trip.slug}`}
            class="group flex items-center gap-4 border border-rule p-4 transition-colors duration-300 hover:bg-black/[0.02] dark:hover:bg-white/[0.02]"
          >
            <span class="text-3xl">{trip.emoji}</span>
            <div>
              <div class="font-medium text-ink group-hover:underline underline-offset-4 decoration-rule">
                {trip.data.title}
              </div>
              <div class="text-sm t-muted mt-0.5">
                {trip.data.startDate} &rarr; {trip.data.endDate} &middot;{" "}
                {trip.data.region}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</PageLayout>
