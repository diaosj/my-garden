---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/Layout.astro";
import { VOYAGES } from "@consts";
import Entry from "@components/Entry.astro";
import kyushu from "@data/kyushu-2026.json";
import sendai from "@data/sendai-2026.json";
import bali from "@data/bali-2026.json";

const trips = [
  { slug: "bali-2026", data: bali, emoji: "\u{1F334}" },
  { slug: "sendai-2026", data: sendai, emoji: "\u{1F386}" },
  { slug: "kyushu-2026", data: kyushu, emoji: "\u{1F338}" },
];
---

<PageLayout title={VOYAGES.TITLE} description={VOYAGES.DESCRIPTION}>
  <Container>
    <h1 class="animate font-mono text-xl font-medium text-ink">
      {VOYAGES.TITLE}
    </h1>
    <p class="animate t-muted mt-2">
      {VOYAGES.DESCRIPTION}
    </p>

    <div class="animate mt-8">
      {
        trips.map((trip) => (
          <Entry
            href={`/voyages/${trip.slug}`}
            title={`${trip.emoji} ${trip.data.title}`}
            description={trip.data.region}
            meta={`${trip.data.startDate} → ${trip.data.endDate}`}
          />
        ))
      }
    </div>
  </Container>
</PageLayout>
