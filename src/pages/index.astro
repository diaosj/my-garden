---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/Layout.astro";
import Entry from "@components/Entry.astro";
import Link from "@components/Link.astro";
import { HOME } from "@consts";
import { graph, PERSON_JSONLD, WEBSITE_JSONLD } from "@lib/seo";

const jsonld = graph(PERSON_JSONLD, WEBSITE_JSONLD);

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} jsonld={jsonld}>
  <Container>
    <div class="space-y-24">
      <!-- 1. 门面/名片区 (Hero) -->
      <section class="animate flex flex-col items-center text-center py-16 sm:py-24">
        <h1 class="font-semibold text-ink text-4xl sm:text-5xl tracking-tight">
          Shoujun <span class="font-normal t-muted">(Adrian)</span> Diao
        </h1>
        <p class="mt-3 text-base tracking-[0.3em] t-muted" lang="zh-CN">刁寿钧</p>
        <p class="mt-6 leading-relaxed t-muted max-w-xl text-lg">
          Architecting backend systems and AI infrastructure built to last.
        </p>
        <div class="mt-8">
          <Link href="/about">More about me & connect ↗</Link>
        </div>
      </section>

      <!-- 2. 思考/文章区 (Thoughts & Notes) -->
      <section class="animate space-y-6">
        <div class="flex items-end justify-between border-b border-rule pb-4">
          <h5 class="font-medium text-ink tracking-wide uppercase text-sm">
            Latest from the Journal
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <Entry href={`/blog/${post.id}`} title={post.data.title} description={post.data.description} />
            </li>
          ))}
        </ul>
      </section>

      <!-- 3. 实验室/Demo区 (The Lab) -->
      <section class="animate space-y-6">
        <div class="flex items-end justify-between border-b border-rule pb-4">
          <h5 class="font-medium text-ink tracking-wide uppercase text-sm">
            Selected Craft
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <Entry href={`/projects/${project.id}`} title={project.data.title} description={project.data.description} />
            </li>
          ))}
        </ul>
      </section>

      <!-- 4. 生活与社区区 (Life & Community) -->
      <section class="animate space-y-6">
        <div class="flex items-end justify-between border-b border-rule pb-4">
          <h5 class="font-medium text-ink tracking-wide uppercase text-sm">
            Beyond the Code
          </h5>
        </div>
        <ul class="flex flex-col">
          <li class="group flex flex-col sm:grid sm:grid-cols-[5fr_4fr] sm:gap-x-8 sm:items-center py-6 border-b border-rule">
            <h3 class="font-medium text-ink text-lg">Speaker at Apache APISIX Meetup</h3>
            <div class="font-mono text-xs t-muted mt-2 sm:mt-0 text-sm sm:text-base">Building High-Performance Gateways</div>
          </li>
          <li class="group flex flex-col sm:grid sm:grid-cols-[5fr_4fr] sm:gap-x-8 sm:items-center py-6 border-b border-rule">
            <h3 class="font-medium text-ink text-lg">Co-translator: Problem Solving with Algorithms and Data Structures Using Python</h3>
            <div class="font-mono text-xs t-muted mt-2 sm:mt-0 text-sm sm:text-base">Posts &amp; Telecom Press · 2019</div>
          </li>
          <li class="group flex flex-col sm:grid sm:grid-cols-[5fr_4fr] sm:gap-x-8 sm:items-center py-6 border-b border-rule">
            <h3 class="font-medium text-ink text-lg">Translator: Practical Data Analysis</h3>
            <div class="font-mono text-xs t-muted mt-2 sm:mt-0 text-sm sm:text-base">China Machine Press · 2018</div>
          </li>
          <li class="group flex flex-col sm:grid sm:grid-cols-[5fr_4fr] sm:gap-x-8 sm:items-center py-6 border-b border-rule">
            <h3 class="font-medium text-ink text-lg">Community Builder</h3>
            <div class="font-mono text-xs t-muted mt-2 sm:mt-0 text-sm sm:text-base">Led the Tencent Football Association (200+ members)</div>
          </li>
          <li class="group flex flex-col sm:grid sm:grid-cols-[5fr_4fr] sm:gap-x-8 sm:items-center py-6 border-b border-rule">
            <h3 class="font-medium text-ink text-lg">Volunteer Go (Weiqi) Instructor</h3>
            <div class="font-mono text-xs t-muted mt-2 sm:mt-0 text-sm sm:text-base">Mentored children of migrant workers in Shanghai</div>
          </li>
        </ul>
      </section>

    </div>
  </Container>
</PageLayout>
