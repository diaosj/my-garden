---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/Layout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { HOME } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h1 class="animate font-semibold text-black dark:text-white mb-6">
      Hi, I'm Shoujun (Adrian) Diao
    </h1>
    
    <div class="space-y-16">
      <!-- 1. 门面/名片区 (Hero) -->
      <section>
        <article class="space-y-4">
          <p class="animate font-medium text-black dark:text-white">
            AI Platform Architect & Staff Engineer | 14 Years of Software Engineering Experience
          </p>
          <p class="animate">
            Welcome to my digital garden. With over 13.5 years dedicated to software engineering and 5+ years specifically architecting scalable, resilient AI platforms on <strong>K8s, Go, and Python</strong>, I am driven by a passion for creating robust systems that empower complex AI solutions.
          </p>
          <p class="animate">
            My journey into AI was profoundly influenced by AlphaGo. As an <strong>amateur 5-dan Go player</strong>, witnessing its breakthrough was the key catalyst for my career pivot, leading me to self-teach Deep Reinforcement Learning. 
          </p>
        </article>
      </section>

      <!-- 2. 思考/文章区 (Thoughts & Notes) -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Thoughts & Notes
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <!-- 3. 实验室/Demo区 (The Lab) -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            The Lab
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
          <!-- 硬编码的静态 Demo 接入点 -->
          <li class="group relative flex flex-col gap-2 rounded-md border border-black/10 dark:border-white/10 p-4 transition-colors hover:bg-black/5 dark:hover:bg-white/5">
            <a href="/demos/weather/index.html" target="_blank" class="w-full flex justify-between items-center">
              <div class="flex flex-col">
                <div class="font-semibold text-black dark:text-white">AI Inference API (Static Demo)</div>
                <div class="text-sm opacity-75">A pure static frontend demo talking to my backend infrastructure.</div>
              </div>
              <svg xmlns="http://www.w3.org/20svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white">
                <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 translate-x-[10px] transition-all duration-300 ease-in-out group-hover:scale-x-100 group-hover:translate-x-0"></line>
                <polyline points="12 5 19 12 12 19" class="translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1"></polyline>
              </svg>
            </a>
          </li>
        </ul>
      </section>

      <!-- 4. 生活与社区区 (Life & Community) -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Beyond Engineering
          </h5>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="group relative flex flex-col gap-2 rounded-md border border-black/10 dark:border-white/10 p-4 transition-colors hover:bg-black/5 dark:hover:bg-white/5">
            <div class="font-semibold text-black dark:text-white">Speaker at Apache APISIX Meetup</div>
            <div class="text-sm opacity-75">Shared insights on high-performance gateways and cloud-native networking.</div>
          </li>
          <li class="group relative flex flex-col gap-2 rounded-md border border-black/10 dark:border-white/10 p-4 transition-colors hover:bg-black/5 dark:hover:bg-white/5">
            <div class="font-semibold text-black dark:text-white">Technical Book Translator</div>
            <div class="text-sm opacity-75">Translated "Practical Data Analysis" from English to Chinese, honing bilingual technical communication.</div>
          </li>
          <li class="group relative flex flex-col gap-2 rounded-md border border-black/10 dark:border-white/10 p-4 transition-colors hover:bg-black/5 dark:hover:bg-white/5">
            <div class="font-semibold text-black dark:text-white">Community Builder</div>
            <div class="text-sm opacity-75">Revitalized and led the Tencent Football Association for over 200 members.</div>
          </li>
        </ul>
      </section>

    </div>
  </Container>
</PageLayout>
