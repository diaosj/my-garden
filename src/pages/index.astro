---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/Layout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { HOME } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <p class="animate text-xs uppercase tracking-[0.3em] text-white/50 mb-4">
      AI PLATFORM ARCHITECT &amp; STAFF ENGINEER
    </p>
    <h1 class="animate font-semibold text-black dark:text-white mb-6">
      Hi, I'm Shoujun (Adrian) Diao
    </h1>
    
    <div class="space-y-16">
      <!-- 1. 门面/名片区 (Hero) -->
      <section>
        <article class="space-y-4">
          <p class="animate font-serif tracking-wide leading-relaxed font-medium text-black dark:text-white">
            AI Platform Architect &amp; Staff Engineer | 14 Years of Software Engineering Experience | Architecting Scalable &amp; Resilient AI Infrastructure (6 Years <span class="underline decoration-1 underline-offset-4">K8s</span>/Cloud-Native Focus)
          </p>
          <Link href="/about">More about me & connect ↗</Link>
        </article>
      </section>

      <!-- 2. 思考/文章区 (Thoughts & Notes) -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Thoughts & Notes
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <!-- 3. 实验室/Demo区 (The Lab) -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            The Lab
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <!-- 4. 生活与社区区 (Life & Community) -->
      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-black dark:text-white">
            Beyond Engineering
          </h5>
        </div>
        <ul class="flex flex-col gap-4">
          <li class="group relative flex flex-col gap-2 rounded-md border border-black/10 dark:border-white/10 p-4 transition-colors hover:bg-black/5 dark:hover:bg-white/5">
            <div class="font-semibold text-black dark:text-white">Speaker at Apache APISIX Meetup</div>
            <div class="text-sm opacity-75">Shared insights on high-performance gateways and cloud-native networking.</div>
          </li>
          <li class="group relative flex flex-col gap-2 rounded-md border border-black/10 dark:border-white/10 p-4 transition-colors hover:bg-black/5 dark:hover:bg-white/5">
            <div class="font-semibold text-black dark:text-white">Technical Book Translator</div>
            <div class="text-sm opacity-75">Translated "Practical Data Analysis" from English to Chinese, honing bilingual technical communication.</div>
          </li>
          <li class="group relative flex flex-col gap-2 rounded-md border border-black/10 dark:border-white/10 p-4 transition-colors hover:bg-black/5 dark:hover:bg-white/5">
            <div class="font-semibold text-black dark:text-white">Community Builder</div>
            <div class="text-sm opacity-75">Revitalized and led the Tencent Football Association for over 200 members.</div>
          </li>
        </ul>
      </section>

    </div>
  </Container>
</PageLayout>
