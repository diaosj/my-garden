---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/Layout.astro";
import SectionLabel from "@components/SectionLabel.astro";
import Entry from "@components/Entry.astro";
import Link from "@components/Link.astro";
import { HOME } from "@consts";
import { graph, PERSON_JSONLD, WEBSITE_JSONLD } from "@lib/seo";
import { GROUPS, groupPosts } from "@lib/archive";
import { HERO_LINE, NOW, WRITING_IN_PROGRESS, BEYOND_LEAD, BEYOND } from "@data/home";

const jsonld = graph(PERSON_JSONLD, WEBSITE_JSONLD);

const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
const grouped = groupPosts(posts);
const recent = (grouped.get("infra") ?? []).slice(0, 3);

const projects = (await getCollection("projects"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} jsonld={jsonld}>
  <Container>
    <div class="space-y-24">
      <!-- Hero -->
      <section class="animate relative isolate flex flex-col items-start py-16 sm:py-24">
        <div class="grid-bg absolute inset-0 -z-10" aria-hidden="true"></div>
        <h1 class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          Shoujun <span class="t-muted font-normal">(Adrian)</span> Diao
        </h1>
        <p class="t-muted mt-3 font-mono text-sm tracking-[0.3em]" lang="zh-CN">刁寿钧</p>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink">{HERO_LINE}</p>
        <div class="mt-6 font-mono text-xs">
          <Link href="/about">About, and how to reach me ↗</Link>
        </div>
      </section>

      <!-- § 01 Now -->
      <section class="animate space-y-6">
        <SectionLabel index="01" label="Now" stone />
        <div class="max-w-prose space-y-4 leading-relaxed text-ink">
          {NOW.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <!-- § 02 Writing -->
      <section class="animate space-y-2">
        <SectionLabel index="02" label="Writing" stone>
          <Link slot="right" href="/blog">All writing</Link>
        </SectionLabel>
        {
          recent.length > 0
            ? recent.map((post) => (
                <Entry
                  href={`/blog/${post.id}/`}
                  title={post.data.title}
                  description={post.data.description}
                  meta={post.data.date.toISOString().slice(0, 10)}
                />
              ))
            : WRITING_IN_PROGRESS.map((t) => (
                <div class="grid items-baseline gap-x-8 gap-y-1 border-b border-rule py-5 sm:grid-cols-[1fr_auto]">
                  <div>
                    <div class="font-medium text-ink">{t.title}</div>
                    <div class="t-muted mt-1 text-sm">{t.summary}</div>
                  </div>
                  <div class="t-muted font-mono text-xs sm:text-right">in progress</div>
                </div>
              ))
        }
      </section>

      <!-- § 03 Work -->
      <section class="animate space-y-2">
        <SectionLabel index="03" label="Work" stone>
          <Link slot="right" href="/projects">All work</Link>
        </SectionLabel>
        {
          projects.map((p) => (
            <Entry
              href={p.data.demoURL ?? `/projects/${p.id}/`}
              external={!!p.data.demoURL}
              title={p.data.title}
              description={p.data.description}
              meta={p.data.date.getFullYear().toString()}
            />
          ))
        }
      </section>

      <!-- § 04 Archive -->
      <section class="animate space-y-2">
        <SectionLabel index="04" label="Archive" stone>
          <span slot="right">2008 – 2016</span>
        </SectionLabel>
        {
          GROUPS.filter((g) => g.id !== "infra").map((g) => (
            <Entry
              href={`/blog#${g.id}`}
              title={g.label}
              description={g.intro}
              meta={`${(grouped.get(g.id) ?? []).length} posts`}
            />
          ))
        }
      </section>

      <!-- § 05 Beyond -->
      <section class="animate space-y-2">
        <SectionLabel index="05" label="Beyond" stone />
        <p class="t-muted max-w-prose py-4">{BEYOND_LEAD}</p>
        {
          BEYOND.map((b) => (
            <div class="grid items-baseline gap-x-8 gap-y-1 border-b border-rule py-4 sm:grid-cols-[1fr_auto]">
              <div class="text-ink">{b.title}</div>
              <div class="t-muted font-mono text-xs sm:text-right">{b.meta}</div>
            </div>
          ))
        }
      </section>
    </div>
  </Container>
</PageLayout>
