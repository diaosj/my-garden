---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  /** BCP-47 language of the page's main content. Defaults to "en". */
  lang?: string;
  image?: string;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: "website" | "article";
};

const { title, description, lang = "en", image, jsonld, ogType } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
      jsonld={jsonld}
      ogType={ogType}
    />
  </head>
  <body>
    <noscript>
      <style>
        .animate{
          opacity:1;
          translate: var(--tw-translate-x) calc(var(--spacing) * 0);
        }
      </style>
    </noscript>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Pagefind />
  </body>
</html>
