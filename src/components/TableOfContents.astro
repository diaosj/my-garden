---
import TableOfContentsHeading from "./TableOfContentsHeading.astro";

// https://kld.dev/building-table-of-contents/
const { headings } = Astro.props;
const toc = buildToc(headings);

export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

function buildToc(headings: Heading[]) {
  // Tolerant of posts whose headings start at h1 or skip levels:
  // the shallowest depth becomes the top level, and a heading whose parent
  // level is missing attaches to the nearest shallower heading (or the root).
  const toc: Heading[] = [];
  const parentHeadings = new Map<number, Heading & { subheadings: Heading[] }>();
  const minDepth = Math.min(...headings.map((h) => h.depth));
  headings.forEach((h) => {
    const heading = { ...h, subheadings: [] as Heading[] };
    for (const d of [...parentHeadings.keys()]) if (d >= heading.depth) parentHeadings.delete(d);
    parentHeadings.set(heading.depth, heading);
    let parent: (Heading & { subheadings: Heading[] }) | undefined;
    for (let d = heading.depth - 1; d >= minDepth; d--) {
      parent = parentHeadings.get(d);
      if (parent) break;
    }
    if (heading.depth === minDepth || !parent) {
      toc.push(heading);
    } else {
      parent.subheadings.push(heading);
    }
  });
  return toc;
}
---

<details
  open
  class="animate group border border-rule"
>
  <summary
    class="cursor-pointer px-3 py-1.5 font-medium transition-colors group-open:bg-rule hover:bg-rule"
    >Table of Contents</summary
  >
  <nav>
    <ul class="py-3">
      {toc.map((heading) => <TableOfContentsHeading heading={heading} />)}
    </ul>
  </nav>
</details>
