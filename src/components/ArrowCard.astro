---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="not-prose group flex flex-col sm:grid sm:grid-cols-[60%_40%] sm:items-center py-6 border-b border-black/5 dark:border-white/5"
>
  <h3 class="font-medium text-black dark:text-white text-lg group-hover:underline underline-offset-4 decoration-black/20 dark:decoration-white/20">
    {entry.data.title}
  </h3>
  <div class="font-serif italic text-black/50 dark:text-white/50 mt-2 sm:mt-0 text-sm sm:text-base">
    {entry.data.description}
  </div>
</a>
