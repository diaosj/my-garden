---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="not-prose group flex flex-col sm:grid sm:grid-cols-[5fr_4fr] sm:gap-x-8 sm:items-center py-6 border-b border-rule"
>
  <h3 class="font-medium text-ink text-lg group-hover:underline underline-offset-4 decoration-rule">
    {entry.data.title}
  </h3>
  <div class="font-mono text-xs t-muted mt-2 sm:mt-0 text-sm sm:text-base">
    {entry.data.description}
  </div>
</a>
